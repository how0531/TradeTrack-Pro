# TradeTrack-Pro Environment Configuration
# 
# For local development (connecting to cloud backend):
# Copy this file to `.env` and update VITE_API_URL with your Render backend URL
#
# For local development (connecting to local backend):
# Leave VITE_API_URL empty or comment it out
#
# The vite.config.ts proxy will automatically redirect /api requests to localhost:5000
# when VITE_API_URL is not set.

# Cloud Backend URL (Render deployment)
# Find your URL at: https://dashboard.render.com → Your Service → URL
# Example: VITE_API_URL=https://tradetrack-backend.onrender.com
VITE_API_URL=

# For production build, this should be set to your deployed backend URL

# --- Firebase Web SDK ---
# Web Firebase keys are public by design (they ship in the JS bundle); real
# security comes from Firestore Rules + App Check. Set these so a fork can
# target a different Firebase project without editing source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend (Flask + Shioaji) ---
# Comma-separated list of allowed CORS origins for the Python backend.
# Example: ALLOWED_ORIGINS=https://tradetrack-pro.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
